# Copy this file to ".env" in the backend/ directory and fill in real values.
# Never commit the actual ".env" file.

# --- Application ---
APP_NAME=Air Canvas for Video Meetings
DEBUG=True
ENVIRONMENT=development

# --- Database ---
# SQLite file path, relative to backend/ working directory.
DATABASE_URL=sqlite:///./app_data.db

# --- Security / JWT ---
# Generate a real value with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# --- WebRTC ---
STUN_SERVER=stun:stun.l.google.com:19302
